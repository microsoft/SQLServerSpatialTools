<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>SQLSpatialTools</RootNamespace>
    <AssemblyName>SQLSpatialTools</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\output\lib\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.Types" Version="170.1000.7" />
    <SqlClrFriendAssembly Include="SQLSpatialTools.UnitTests;SQLSpatialTools.UnitTests.DDD;SQLSpatialTools.UnitTests.Extension" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Sinks\Geometry\BuidLRSMultiLineSink.cs;Sinks\Geometry\ClipGeometrySegmentSink.cs" />
    <EmbeddedResource Update="Resource\Resource.resx"
                      LogicalName="SQLSpatialTools.Resource.Resource.resources" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != '' and $([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETFramework'">
    <None Update="SQL Scripts\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="SQL Scripts\util_geometry_example.sql" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <Target Name="PrepareSqlClrRegistrationScripts"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_SqlClrScriptTemplate Include="SQL Scripts\Register.sql;SQL Scripts\RegisterAndValidate.sql" />
    </ItemGroup>
    <Delete Files="$([System.IO.Path]::Combine('$(TargetDir)', 'SQL Scripts', 'TrustAssembly.sql'))" />
    <SqlClrScripts SourceFiles="@(_SqlClrScriptTemplate)"
                   AssemblyPath="$(TargetPath)"
                   OutputDirectory="$([System.IO.Path]::Combine('$(TargetDir)', 'SQL Scripts'))">
      <Output TaskParameter="WrittenFiles" ItemName="FileWrites" />
    </SqlClrScripts>
  </Target>

  <Target Name="GenerateSqlClrTrustScript" DependsOnTargets="Build">
    <MSBuild Condition="'$(IsCrossTargetingBuild)' == 'true'"
             Projects="$(MSBuildProjectFullPath)"
             Targets="GenerateSqlClrTrustScript"
             Properties="TargetFramework=net472" />
    <Error Condition="'$(IsCrossTargetingBuild)' != 'true' and '$(_SqlClrSigningActive)' != 'true'"
           Text="Trust script generation requires a .NET Framework build with SqlClrSigningMode=Development or Production." />
    <SqlClrScripts Condition="'$(IsCrossTargetingBuild)' != 'true'"
                   GenerateTrustScript="true"
                   AssemblyPath="$(TargetPath)"
                   OutputDirectory="$([System.IO.Path]::Combine('$(TargetDir)', 'SQL Scripts'))"
                   ServerAssemblyPath="$(SqlClrTrustAssemblyPath)"
                   ExpectedPublicKey="$(_SqlClrSigningPublicKey)"
                   SigningMode="$(SqlClrSigningMode)">
      <Output TaskParameter="WrittenFiles" ItemName="FileWrites" />
    </SqlClrScripts>
  </Target>

  <Target Name="GenerateSqlClrTrustScriptAfterBuild"
          AfterTargets="Build"
          Condition="'$(SqlClrGenerateTrustScript)' == 'true' and '$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(IsCrossTargetingBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <CallTarget Targets="GenerateSqlClrTrustScript" />
  </Target>
</Project>

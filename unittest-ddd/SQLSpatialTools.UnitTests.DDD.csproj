<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>SQLSpatialTools.UnitTests.DDD</RootNamespace>
    <AssemblyName>SQLSpatialTools.UnitTests.DDD</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\output\unittest-ddd\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IsTestProject>true</IsTestProject>
    <RunDDDTests Condition="'$(RunDDDTests)' == ''">false</RunDDDTests>
    <RunSettingsFilePath Condition="'$(RunDDDTests)' == 'true' and '$(RunSettingsFilePath)' == ''">$(MSBuildProjectDirectory)\DDD.runsettings</RunSettingsFilePath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\SQLSpatialTools.csproj" />
    <ProjectReference Include="..\unittest-extension\SQLSpatialTools.UnitTests.Extension.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper.StrongName" Version="2.1.79" />
    <PackageReference Include="Microsoft.SqlServer.Compact"
                      Version="4.0.8876.1"
                      GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.36.0" />
    <PackageReference Include="Microsoft.SqlServer.Types" Version="170.1000.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
    <PackageReference Include="Oracle.ManagedDataAccess" Version="23.26.300" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\**\*.data" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\Util\*.data" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <Target Name="ValidateRunDDDTests" BeforeTargets="PrepareForBuild;VSTest">
    <Error Condition="'$(RunDDDTests)' != 'true' and '$(RunDDDTests)' != 'false'"
           Text="RunDDDTests must be true or false. Set RunDDDTests=true only for a configured DDD integration-test environment." />
  </Target>

  <Target Name="CopySqlServerCompactNativeBinaries" AfterTargets="Build">
    <ItemGroup>
      <SqlCompactX86Binary Include="$(PkgMicrosoft_SqlServer_Compact)\NativeBinaries\x86\**\*.*" />
      <SqlCompactAmd64Binary Include="$(PkgMicrosoft_SqlServer_Compact)\NativeBinaries\amd64\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SqlCompactX86Binary)"
          DestinationFiles="@(SqlCompactX86Binary->'$(TargetDir)x86\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SqlCompactAmd64Binary)"
          DestinationFiles="@(SqlCompactAmd64Binary->'$(TargetDir)amd64\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
